% megn301.sty — Shared style package for MEGN 301 course materials
% Colorado School of Mines, Department of Mechanical Engineering
% Adam Duran, March 2026
%
% Usage:
%   MRD:  \usepackage{megn301}              (default, book-class features)
%   SG:   \usepackage[article]{megn301}     (article-class features)
%
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{megn301}[2026/03/18 MEGN 301 shared style package]

% ── Options ─────────────────────────────────────────────────────────
\newif\if@megnarticle\@megnarticlefalse
\DeclareOption{article}{\@megnarticletrue}
\ProcessOptions\relax

% ── Packages ────────────────────────────────────────────────────────
\RequirePackage{enumitem}
\RequirePackage{booktabs}
\RequirePackage{tabularx}
\RequirePackage{longtable}
\RequirePackage{array}
\RequirePackage{amsmath,amssymb}
\RequirePackage{siunitx}
\RequirePackage{xcolor}
\RequirePackage{tcolorbox}

\RequirePackage{graphicx}
\RequirePackage{float}
\RequirePackage[T1]{fontenc}
\RequirePackage{textcomp}
\RequirePackage{multicol}
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric,arrows.meta,positioning,calc,decorations.pathreplacing,fit,backgrounds}

% ── Colors ──────────────────────────────────────────────────────────
% Primary palette
\definecolor{MinesBlue}{HTML}{21314D}
\definecolor{MinesSilver}{HTML}{A2A4A3}
\definecolor{AccentTeal}{HTML}{00796B}
\definecolor{WarnOrange}{HTML}{E65100}
\definecolor{LightBG}{HTML}{F5F7FA}

% TikZ diagram colors
\definecolor{vdefine}{HTML}{21314D}
\definecolor{vverify}{HTML}{00796B}
\definecolor{vbuild}{HTML}{E65100}
\definecolor{diagYellow}{HTML}{F9A825}
\definecolor{diagGreen}{HTML}{2E7D32}
\definecolor{diagRed}{HTML}{C62828}
\definecolor{diagPurple}{HTML}{6A1B9A}

% Student Guide aliases (map to primary palette)
\colorlet{minesblue}{MinesBlue}
\colorlet{minesgold}{diagYellow}
\colorlet{tipgreen}{diagGreen}
\colorlet{warnred}{diagRed}
\colorlet{lightgray}{LightBG}

% ── Custom Commands ─────────────────────────────────────────────────
\newcommand{\degC}{\ensuremath{{}^{\circ}\text{C}}}
\newcommand{\degF}{\ensuremath{{}^{\circ}\text{F}}}
\providecommand{\ang}[1]{#1\ensuremath{{}^{\circ}}}

% ── Hyperref Setup ──────────────────────────────────────────────────
% plainpages=false and pdfpagelabels are load-time options, set via package options
\RequirePackage[plainpages=false,pdfpagelabels,hypertexnames=false]{hyperref}

% ── Hyperref color setup ────────────────────────────────────────────
\hypersetup{
    colorlinks=true,
    linkcolor=MinesBlue,
    urlcolor=AccentTeal,
    citecolor=MinesBlue
}

% ── tcolorbox environments (shared across MRD and SG) ──────────────
\tcbuselibrary{skins,breakable}

\newtcolorbox{greenshieldbox}[1][]{%
    enhanced, breakable,
    colback=AccentTeal!5, colframe=AccentTeal!70!black,
    fonttitle=\bfseries\sffamily, title={\textsf{GS}~#1},
    boxrule=1pt, arc=3pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{keyconceptbox}[1][]{%
    enhanced, breakable,
    colback=LightBG, colframe=MinesBlue,
    fonttitle=\bfseries\sffamily, title={#1},
    boxrule=0.8pt, arc=2pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{warningbox}[1][]{%
    enhanced, breakable,
    colback=WarnOrange!8, colframe=WarnOrange,
    fonttitle=\bfseries\sffamily, title={#1},
    boxrule=0.8pt, arc=2pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{tipbox}[1][]{%
    enhanced, breakable,
    colback=AccentTeal!8, colframe=AccentTeal,
    fonttitle=\bfseries\sffamily, title={#1},
    boxrule=0.8pt, arc=2pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{checklistbox}[1][]{%
    enhanced, breakable,
    colback=MinesBlue!4, colframe=MinesBlue!60,
    fonttitle=\bfseries\sffamily, title={\checkmark~#1},
    boxrule=0.8pt, arc=2pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{quickrefbox}[1][]{%
    enhanced, breakable,
    colback=LightBG, colframe=MinesSilver!70!black,
    fonttitle=\bfseries\sffamily, title={#1},
    boxrule=0.8pt, arc=2pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

% Student Guide-specific boxes (also available in MRD if needed)
\newtcolorbox{faqbox}[1][]{%
    colback=LightBG, colframe=MinesBlue,
    fonttitle=\bfseries, title={#1},
    arc=2pt, boxrule=0.8pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{warnbox}{%
    colback=diagRed!5, colframe=diagRed,
    fonttitle=\bfseries\color{diagRed}, title={Common Pitfall},
    arc=2pt, boxrule=0.8pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{protip}{%
    colback=diagYellow!8, colframe=diagYellow!80!black,
    fonttitle=\bfseries\color{diagYellow!80!black}, title={Pro Tip},
    arc=2pt, boxrule=0.8pt, left=6pt, right=6pt, top=4pt, bottom=4pt}

\newtcolorbox{priorities}{%
    colback=MinesBlue!5, colframe=MinesBlue!60,
    fonttitle=\bfseries\color{MinesBlue},
    title={\small$\blacktriangleright$ Top Priorities This Sprint},
    arc=2pt, boxrule=0.6pt, left=6pt, right=6pt, top=3pt, bottom=3pt,
    before upper={\small}}

% ── TikZ global styles ─────────────────────────────────────────────
\tikzset{
    slabel/.style={font=\scriptsize\sffamily\bfseries, color=#1,
        inner sep=2pt, fill=white, rounded corners=1pt},
    flow/.style={->, line width=1.2pt, color=#1, shorten <=1pt, shorten >=1pt},
    dim/.style={circle, draw=#1, fill=#1!8, minimum size=3.0cm,
        font=\scriptsize\sffamily\bfseries, align=center, line width=1pt, opacity=0.85},
    dlabel/.style={font=\scriptsize\sffamily, color=#1, align=center},
    milestone/.style={rectangle, rounded corners=3pt, draw=#1, fill=#1!8,
        text width=3.6cm, minimum height=2.2cm, align=left,
        font=\scriptsize\sffamily, line width=0.8pt, inner sep=5pt},
    mlabel/.style={font=\small\sffamily\bfseries, color=#1},
    stage/.style={rectangle, rounded corners=3pt, draw=#1, fill=#1!8,
        text width=2.6cm, minimum height=1.0cm, align=center,
        font=\scriptsize\sffamily\bfseries, line width=0.8pt},
    phase/.style={rectangle, rounded corners=3pt, draw=#1, fill=#1!8,
        text width=2.4cm, minimum height=1.0cm, align=center,
        font=\scriptsize\sffamily\bfseries, line width=0.8pt},
    tier/.style={rectangle, rounded corners=2pt, draw=#1, fill=#1!12,
        minimum height=0.65cm, align=center, font=\scriptsize\sffamily\bfseries,
        line width=0.7pt},
    block/.style={rectangle, rounded corners=2pt, draw=#1, fill=#1!8,
        minimum width=2.0cm, minimum height=0.8cm, align=center,
        font=\tiny\sffamily\bfseries, line width=0.7pt},
    cat/.style={rectangle, rounded corners=3pt, draw=#1, fill=#1!10,
        text width=2.2cm, minimum height=0.8cm, align=center,
        font=\tiny\sffamily\bfseries, line width=0.7pt},
    review/.style={rectangle, rounded corners=4pt, draw=#1, fill=#1!10,
        text width=3.2cm, minimum height=2.0cm, align=center,
        font=\small\sffamily\bfseries, line width=1.0pt},
    question/.style={font=\scriptsize\sffamily\itshape, color=#1,
        text width=3.2cm, align=center},
    bmcell/.style={rectangle, draw=MinesBlue!50, align=center, font=\tiny\sffamily,
        inner sep=3pt, line width=0.5pt}
}

\endinput
